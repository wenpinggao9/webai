{
  "cases": [
    {
      "case_id": "录制_流程_016",
      "module": "录制",
      "priority": "P0",
      "origin_case": {
        "preconditions": [],
        "format": "interleaved",
        "blocks": [
          {
            "steps": [
              "打开「待上传」页面"
            ],
            "expectations": [
              "待上传页展示「领取题目」Tab，且已进入任务详情（页面含「题干」或「题目ID」）",
              "展示题目内容、右下角有「提交视频」和「制作PPT」"
            ]
          },
          {
            "steps": [
              "点击「提交视频」"
            ],
            "expectations": [
              "弹出视频上传选择框"
            ]
          },
          {
            "steps": [
              "点击「上传视频文件」"
            ],
            "expectations": [
              "出现文件上传入口"
            ]
          },
          {
            "steps": [
              "上传资源「录制视频」"
            ],
            "expectations": [
              "展示加载进度条"
            ]
          },
          {
            "steps": [
              "加载完成并确认提交"
            ],
            "expectations": [
              "返回待上传页面，详情展示「查看视频」和「提交任务」"
            ]
          },
          {
            "steps": [
              "提交任务"
            ],
            "expectations": [
              "「领取题目」Tab 下无待办任务"
            ]
          },
          {
            "steps": [
              "选择「已上传」"
            ],
            "expectations": [
              "状态默认选中为「待申诉」"
            ]
          },
          {
            "steps": [
              "点击「状态」框中的「x」，并「提交」进行查询"
            ],
            "expectations": [
              "最近一条数据为待自审，学段=大学，学科=大学化学"
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "click",
          "intent": "点击侧栏菜单'待上传'进入待上传页面",
          "extras": {
            "codegen_post_wait": {
              "kind": "url_contains",
              "fragment": "/video/tasklist"
            }
          }
        },
        {
          "type": "assert_text",
          "intent": "验证待上传页展示'领取题目'Tab",
          "value": "领取题目",
          "extras": {
            "codegen_assert": {
              "kind": "literal",
              "text": "领取题目"
            }
          }
        },
        {
