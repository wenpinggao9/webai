            "branches": [
              {
                "intent": "验证页面包含'题干'",
                "value": "题干"
              },
              {
                "intent": "验证页面包含'题目ID'",
                "value": "题目ID"
              }
            ]
          }
        },
        {
          "type": "assert_text",
          "intent": "验证页面展示题目内容区域"
        },
        {
          "type": "assert_text",
