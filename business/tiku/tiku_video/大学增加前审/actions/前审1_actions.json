          "工单ID=${orderId1}和工单ID=${orderId2}的生产状态都为「待前审」"
        ]
      },
      "actions": [
        {
          "type": "api_call",
          "intent": "投放策略来源、大学学段、数学学科的题目（第1题），获取 orderId1"
        },
        {
          "type": "api_call",
          "intent": "投放策略来源、大学学段、数学学科的题目（第2题），获取 orderId2"
        },
        {
          "type": "click",
          "intent": "点击'全部题目'"
        },
        {
          "type": "click",
          "intent": "在筛选区点击'来源'下拉框"
        },
        {
          "type": "click",
          "intent": "在下拉选项中点击'策略'"
        },
        {
          "type": "click",
          "intent": "在筛选区点击'学段'下拉框"
        },
        {
          "type": "click",
          "intent": "在下拉选项中点击'大学'"
        },
        {
          "type": "click",
          "intent": "在筛选区点击'学科'下拉框"
        },
        {
          "type": "click",
          "intent": "在下拉选项中点击'数学'"
        },
        {
          "type": "click",
          "intent": "点击'提交'按钮"
        },
        {
          "type": "assert_text",
          "intent": "验证列表中存在工单ID为${orderId1}的记录",
          "value": "${orderId1}"
        },
        {
          "type": "assert_text",
          "intent": "验证列表中存在工单ID为${orderId2}的记录",
          "value": "${orderId2}"
        },
        {
          "type": "assert_table",
          "intent": "验证工单ID为${orderId1}的生产状态为待前审",
          "value": "${orderId1}",
          "extras": {
            "column": "生产状态",
            "expected": "待前审",
            "row_key_column": "工单ID"
          }
        },
        {
          "type": "assert_table",
          "intent": "验证工单ID为${orderId2}的生产状态为待前审",
          "value": "${orderId2}",
          "extras": {
            "column": "生产状态",
            "expected": "待前审",
            "row_key_column": "工单ID"
          }
        }
      ],
      "action_count": 14
    },
