        ],
        "expectations": [
          "列表中存在工单ID=${orderId9}",
          "工单ID=${orderId9}的生产状态为「已退回」",
          "列表中最近一条数据学段为「大学」，学科为「物理」"
        ]
      },
      "actions": [
        {
          "type": "click",
          "intent": "点击'全部题目'"
        },
        {
          "type": "click",
          "intent": "在筛选区点击'学段'下拉框"
        },
        {
          "type": "click",
          "intent": "在下拉选项中点击'大学'"
        },
        {
          "type": "click",
          "intent": "在筛选区点击'来源'下拉框"
        },
        {
          "type": "click",
          "intent": "在下拉选项中点击'策略投放'"
        },
        {
          "type": "click",
          "intent": "点击'提交'按钮进行查询"
        },
        {
          "type": "assert_text",
          "intent": "验证列表中存在工单ID为${orderId9}的记录",
          "value": "${orderId9}"
        },
        {
          "type": "assert_table",
          "intent": "验证工单ID为${orderId9}的生产状态为已退回",
