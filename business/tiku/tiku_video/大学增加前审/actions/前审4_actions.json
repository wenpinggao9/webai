          }
        },
        {
          "type": "assert_table",
          "intent": "验证列表第一行数据的学段为大学",
          "value": "__first_row__",
          "extras": {
            "column": "学段",
            "expected": "大学",
            "row_position": "first"
          }
        },
        {
          "type": "assert_table",
          "intent": "验证列表第一行数据的学科为物理",
          "value": "__first_row__",
          "extras": {
            "column": "学科",
            "expected": "物理",
            "row_position": "first"
          }
        }
      ]
